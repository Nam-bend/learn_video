# Cấu hình Database Postgres (Hỗ trợ Asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/learn_video

# Khóa API OpenAI hoặc Endpoint Azure Models
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Khóa API Gemini (nếu dùng fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Mô hình ngôn ngữ lớn sử dụng
LLM_MODEL=gpt-4o-mini

# Thư mục lưu trữ tài liệu/video tải lên tạm thời
UPLOAD_DIR=tmp/uploads
